    {
      "parameters": {
        "jsCode": "if ($('Private Test Submission').all().length !== 1) throw new Error('One submission per execution is required');\nconst form = $('Private Test Submission').first().json;\nconst matches = $input.all();\n\n// Reuse an existing customer_id when this customer already exists\nconst existingCustomer = matches.find(item => item.json.customer_id);\n\nconst now = Date.now();\n\nconst customerId = existingCustomer\n  ? existingCustomer.json.customer_id\n  : `C-${now}`;\n\nconst visitId = `V-${now}`;\n\n// Create a unique opaque token for the customer feedback link\nconst feedbackToken =\n  `${now}-${Math.random().toString(36).slice(2, 10)}-${Math.random().toString(36).slice(2, 10)}`;\n\nreturn [\n  {\n    json: {\n      visit_id: visitId,\n      customer_id: customerId,\n      customer_name: form.customer_name,\n      customer_email: form.customer_email,\n      location: form.location,\n      service: form.service,\n      job_status: 'Complete',\n      completed_at: new Date().toISOString(),\n      feedback_request_status: 'Not sent',\n      feedback_request_sent_at: '',\n      feedback_token: feedbackToken,\n      manager_email: form.manager_email\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
